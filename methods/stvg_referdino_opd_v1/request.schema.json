{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Video and query input; no target labels",
  "type": "object",
  "required": ["metadata"],
  "additionalProperties": false,
  "properties": {
    "key": {"type": "string", "description": "Optional fixed per-query random stream identifier"},
    "parses": {"type": "object", "description": "Optional existing query-only Stanza parse, never a GT object category"},
    "metadata": {
      "type": "object",
      "required": ["video_path", "caption", "index", "width", "height", "frame_ids"],
      "properties": {
        "video_path": {"type": "string"},
        "video_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "caption": {"type": "string", "minLength": 1},
        "index": {"type": ["integer", "string"]},
        "width": {"type": "integer", "minimum": 1},
        "height": {"type": "integer", "minimum": 1},
        "frame_ids": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"type": "integer", "minimum": 0}, "description": "Strictly increasing physical frame IDs; original benchmark grid for matched evaluation"}
      }
    }
  }
}
